{
  "name": "feedbackkit-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted in-app feedback inbox: Cloudflare Worker + D1 backend for FeedbackKit.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create feedbackkit",
    "db:migrate:local": "wrangler d1 migrations apply feedbackkit --local",
    "db:migrate:remote": "wrangler d1 migrations apply feedbackkit --remote"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
